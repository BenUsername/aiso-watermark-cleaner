MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DB=aiso_watermark_cleaner

# Optional hosted Layer B rewrite. Without this, the UI still generates the
# same paraphrase, back-translation, and structural prompts as upstream.
WATERMARKS_REWRITE_API_KEY=
WATERMARKS_REWRITE_BASE_URL=https://api.openai.com
WATERMARKS_REWRITE_MODEL=gpt-5-mini
